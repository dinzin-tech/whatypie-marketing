{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} | WhatyPie Blog{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Merriweather:wght@400;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'], serif: ['Merriweather', 'serif'] } } } }
  </script>
  <style>
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #020617; }
    ::-webkit-scrollbar-thumb { background: #059669; border-radius: 4px; }

    /* Reading progress bar */
    #progress-bar { position: fixed; top: 0; left: 0; height: 3px; background: linear-gradient(to right, #10b981, #14b8a6); z-index: 9999; transition: width 0.1s; }

    /* Article prose styles */
    .prose-blog h2 { font-size: 1.5rem; font-weight: 700; color: #f1f5f9; margin: 2rem 0 0.75rem; line-height: 1.3; }
    .prose-blog h3 { font-size: 1.2rem; font-weight: 600; color: #e2e8f0; margin: 1.5rem 0 0.5rem; }
    .prose-blog p { color: #94a3b8; line-height: 1.85; margin-bottom: 1.25rem; font-size: 1.0625rem; }
    .prose-blog ul, .prose-blog ol { color: #94a3b8; padding-left: 1.5rem; margin-bottom: 1.25rem; }
    .prose-blog li { margin-bottom: 0.4rem; line-height: 1.75; }
    .prose-blog strong { color: #e2e8f0; font-weight: 600; }
    .prose-blog a { color: #34d399; text-decoration: underline; text-underline-offset: 3px; }
    .prose-blog blockquote { border-left: 3px solid #10b981; padding-left: 1.25rem; color: #64748b; font-style: italic; margin: 1.5rem 0; }

    .card-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .card-hover:hover { transform: translateY(-3px); }
  </style>
{% endblock %}

{% block content %}
<div id="progress-bar" style="width:0%"></div>

<div class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen">

  {% include 'components/header.html.twig' %}

  <!-- Article Header -->
  <section class="relative pt-36 pb-12 overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[250px] bg-emerald-600/10 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 relative z-10 space-y-5">

      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-emerald-400 transition">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-emerald-400 transition">Blog</a>
        <span>/</span>
        <span class="text-slate-400 truncate max-w-[200px]">{{ post.title }}</span>
      </div>

      <!-- Meta -->
      <div class="flex items-center gap-3 flex-wrap">
        <span class="px-3 py-1 bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-semibold rounded-full">AI Automation</span>
        <span class="text-slate-500 text-xs">{{ post.created_at|date('F d, Y') }}</span>
        <span class="text-slate-600 text-xs">·</span>
        <span class="text-slate-500 text-xs" id="reading-time">Loading…</span>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight tracking-tight">
        {{ post.title }}
      </h1>

      <!-- Excerpt -->
      <p class="text-slate-400 text-lg leading-relaxed border-l-2 border-emerald-500/50 pl-4">
        {{ post.excerpt }}
      </p>

      <!-- Share row -->
      <div class="flex items-center gap-3 pt-2">
        <span class="text-xs text-slate-500">Share:</span>
        <a href="https://twitter.com/intent/tweet?text={{ post.title|url_encode }}&url={{ (constant('BASE_URL') ?? '')|url_encode }}/blog/{{ post.slug }}"
           target="_blank" rel="noopener"
           class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs rounded-lg transition flex items-center gap-1.5">
          𝕏 Twitter
        </a>
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ (constant('BASE_URL') ?? '')|url_encode }}/blog/{{ post.slug }}"
           target="_blank" rel="noopener"
           class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs rounded-lg transition flex items-center gap-1.5">
          in LinkedIn
        </a>
        <button onclick="copyLink()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs rounded-lg transition" id="copy-btn">
          🔗 Copy Link
        </button>
      </div>
    </div>
  </section>

  <!-- Featured Image -->
  {% if post.featured_image %}
  <div class="max-w-4xl mx-auto px-4 sm:px-6 mb-10">
    <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl">
      <img src="{{ post.featured_image }}" alt="{{ post.title }}" class="w-full h-72 sm:h-96 object-cover" />
    </div>
  </div>
  {% endif %}

  <!-- Article Body + Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-12">

      <!-- Article Content -->
      <article class="prose-blog max-w-none" id="article-body">
        {{ post.content|raw }}

        <!-- Media embeds -->
        {% set media = media %}
        {% if media is not empty %}
          <div class="mt-10 space-y-6">
            <h2>Media</h2>
            {% for item in media %}
              {% if item.type == 'youtube' %}
                <div class="rounded-2xl overflow-hidden border border-slate-800 aspect-video">
                  <iframe src="{{ item.url|replace({'watch?v=': 'embed/'}) }}"
                    class="w-full h-full" frameborder="0" allowfullscreen loading="lazy"></iframe>
                </div>
              {% elseif item.type == 'image' %}
                <img src="{{ item.url }}" alt="{{ item.caption ?? '' }}" class="rounded-2xl border border-slate-800 w-full" />
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <!-- End CTA -->
        <div class="mt-14 p-8 rounded-2xl bg-gradient-to-r from-emerald-950 via-slate-900 to-teal-950 border border-emerald-500/30 text-center space-y-4 not-prose">
          <p class="text-white font-bold text-xl">Ready to implement AI automation in your business?</p>
          <p class="text-slate-400 text-sm">Our architects will map out a custom automation roadmap for you — completely free.</p>
          <button onclick="openModal()" class="px-8 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-sm rounded-2xl shadow-lg shadow-emerald-600/30 hover:scale-105 transition">
            Book Free AI Strategy Call →
          </button>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-6 lg:sticky lg:top-28 self-start">

        <!-- About WhatyPie -->
        <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5 space-y-3">
          <div class="flex items-center gap-3">
            <img src="{{ assets('whatypie-logo.png') }}" alt="WhatyPie" class="h-8" />
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">WhatyPie is an enterprise AI Automation & Business Transformation Agency helping businesses eliminate manual work and scale faster.</p>
          <button onclick="openModal()" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl transition">
            Book Free Strategy Call
          </button>
        </div>

        <!-- Table of Contents -->
        <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5 space-y-3" id="toc-box">
          <p class="text-xs font-bold text-white uppercase tracking-wide">In This Article</p>
          <nav id="toc" class="space-y-1.5 text-xs text-slate-400"></nav>
        </div>

        <!-- Related Posts -->
        {% if related is not empty %}
        <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5 space-y-4">
          <p class="text-xs font-bold text-white uppercase tracking-wide">Related Articles</p>
          {% for r in related %}
            <a href="/blog/{{ r.slug }}" class="group block space-y-1 hover:bg-slate-800/50 rounded-xl p-2 -mx-2 transition">
              <p class="text-xs font-semibold text-slate-200 group-hover:text-emerald-300 transition leading-snug line-clamp-2">{{ r.title }}</p>
              <p class="text-xs text-slate-500">{{ r.created_at|date('M d, Y') }}</p>
            </a>
          {% endfor %}
        </div>
        {% endif %}

      </aside>
    </div>
  </div>

  {% include 'components/footer.html.twig' %}
  {% include 'components/booking_modal.html.twig' %}

</div>
{% endblock %}

{% block javascripts %}
<script>
  // Reading progress bar
  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const scrolled = doc.scrollTop / (doc.scrollHeight - doc.clientHeight) * 100;
    document.getElementById('progress-bar').style.width = scrolled + '%';
  });

  // Reading time estimate
  const body = document.getElementById('article-body');
  if (body) {
    const words = body.innerText.trim().split(/\s+/).length;
    const mins = Math.max(1, Math.round(words / 200));
    document.getElementById('reading-time').textContent = mins + ' min read';
  }

  // Auto-generate Table of Contents from h2 tags
  const headings = document.querySelectorAll('#article-body h2');
  const toc = document.getElementById('toc');
  if (headings.length > 0 && toc) {
    headings.forEach((h, i) => {
      const id = 'section-' + i;
      h.id = id;
      const link = document.createElement('a');
      link.href = '#' + id;
      link.textContent = h.textContent;
      link.className = 'block hover:text-emerald-400 transition truncate';
      toc.appendChild(link);
    });
  } else {
    document.getElementById('toc-box')?.remove();
  }

  // Copy link
  function copyLink() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      const btn = document.getElementById('copy-btn');
      btn.textContent = '✓ Copied!';
      btn.classList.add('text-emerald-400');
      setTimeout(() => { btn.textContent = '🔗 Copy Link'; btn.classList.remove('text-emerald-400'); }, 2000);
    });
  }

  // Modal
  function toggleMobileMenu() { document.getElementById('mobileMenu').classList.toggle('hidden'); }
  function openModal() { const m = document.getElementById('bookingModal'); m.classList.remove('hidden'); m.classList.add('flex'); }
  function closeModal() { const m = document.getElementById('bookingModal'); m.classList.add('hidden'); m.classList.remove('flex'); }
  async function handleBookingSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('bookingSubmitBtn');
    const errorEl = document.getElementById('bookingFormError');
    btn.disabled = true; btn.textContent = 'Submitting…'; errorEl.classList.add('hidden');
    try {
      const res = await fetch('/booking/submit', { method: 'POST', body: new URLSearchParams(new FormData(e.target)) });
      const data = await res.json();
      if (data.success) {
        document.getElementById('modalFormContainer').classList.add('hidden');
        document.getElementById('modalSuccessContainer').classList.remove('hidden');
      } else {
        errorEl.textContent = data.message || 'Something went wrong.';
        errorEl.classList.remove('hidden');
        btn.disabled = false; btn.textContent = 'Confirm & Book Session';
      }
    } catch {
      errorEl.textContent = 'Network error. Please try again.';
      errorEl.classList.remove('hidden');
      btn.disabled = false; btn.textContent = 'Confirm & Book Session';
    }
  }
</script>
{% endblock %}

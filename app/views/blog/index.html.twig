{% extends 'base.html.twig' %}

{% block title %}Blog — AI Automation Insights | WhatyPie{% endblock %}

{% block canonical %}https://whatypie.in/blog{% endblock %}

{% block meta_description %}Explore our latest insights, guides, and trends on AI automation, custom workflow agents, and enterprise digital transformation.{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } } }
  </script>
  <style>
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #020617; }
    ::-webkit-scrollbar-thumb { background: #059669; border-radius: 4px; }
    .card-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .card-hover:hover { transform: translateY(-3px); box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  </style>
{% endblock %}

{% block content %}
<div class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen">

  {% include 'components/header.html.twig' %}

  <!-- Hero -->
  <section class="relative pt-36 pb-16 overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-emerald-600/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-xs font-semibold text-emerald-300 uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping inline-block"></span>
        AI Automation Insights
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        The WhatyPie <span class="bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent">Intelligence Blog</span>
      </h1>
      <p class="text-slate-400 text-base max-w-xl mx-auto">
        Strategic insights on AI automation, workflow intelligence, and business transformation — written for operators, not engineers.
      </p>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">

    {% if posts is empty %}
      <div class="text-center py-24 space-y-4">
        <div class="text-5xl">✍️</div>
        <p class="text-slate-400 text-lg">No posts published yet. Check back soon.</p>
      </div>
    {% else %}

      {# Featured post — first item #}
      {% set featured = posts[0] %}
      <a href="/blog/{{ featured.slug }}" class="group block mb-10 card-hover">
        <div class="rounded-3xl bg-slate-900 border border-slate-800 hover:border-emerald-500/40 overflow-hidden grid grid-cols-1 lg:grid-cols-2 transition-colors duration-300">
          <!-- Image / Placeholder -->
          <div class="relative min-h-[240px] lg:min-h-full bg-gradient-to-br from-emerald-950 via-slate-900 to-teal-950 flex items-center justify-center overflow-hidden">
            {% if featured.featured_image %}
              <img src="{{ featured.featured_image }}" alt="{{ featured.title }}" class="w-full h-full object-cover absolute inset-0" />
              <div class="absolute inset-0 bg-slate-950/40"></div>
            {% else %}
              <div class="absolute inset-0 opacity-10">
                <div class="absolute top-8 left-8 w-32 h-32 rounded-full bg-emerald-500 blur-3xl"></div>
                <div class="absolute bottom-8 right-8 w-24 h-24 rounded-full bg-teal-500 blur-2xl"></div>
              </div>
              <span class="relative text-6xl">🤖</span>
            {% endif %}
            <span class="absolute top-4 left-4 px-3 py-1 bg-emerald-500 text-slate-950 text-xs font-bold rounded-full">Featured</span>
          </div>
          <!-- Content -->
          <div class="p-8 lg:p-10 flex flex-col justify-center space-y-4">
            <p class="text-xs text-slate-500">{{ featured.created_at|date('M d, Y') }}</p>
            <h2 class="text-2xl lg:text-3xl font-bold text-white group-hover:text-emerald-300 transition-colors leading-snug">
              {{ featured.title }}
            </h2>
            <p class="text-slate-400 text-sm leading-relaxed line-clamp-3">{{ featured.excerpt }}</p>
            <div class="flex items-center gap-2 text-emerald-400 text-sm font-semibold pt-2">
              Read Article
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </div>
        </div>
      </a>

      {# Remaining posts grid #}
      {% if posts|length > 1 %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for post in posts|slice(1) %}
            <a href="/blog/{{ post.slug }}" class="group card-hover block rounded-2xl bg-slate-900 border border-slate-800 hover:border-emerald-500/40 overflow-hidden transition-colors duration-300">
              <!-- Thumbnail -->
              <div class="relative h-44 bg-gradient-to-br from-emerald-950 via-slate-900 to-teal-950 flex items-center justify-center overflow-hidden">
                {% if post.featured_image %}
                  <img src="{{ post.featured_image }}" alt="{{ post.title }}" class="w-full h-full object-cover absolute inset-0" />
                  <div class="absolute inset-0 bg-slate-950/30"></div>
                {% else %}
                  <div class="absolute inset-0 opacity-10">
                    <div class="absolute top-4 left-4 w-20 h-20 rounded-full bg-emerald-500 blur-2xl"></div>
                    <div class="absolute bottom-4 right-4 w-16 h-16 rounded-full bg-teal-500 blur-xl"></div>
                  </div>
                  <span class="relative text-4xl">⚡</span>
                {% endif %}
              </div>
              <!-- Content -->
              <div class="p-5 space-y-3">
                <p class="text-xs text-slate-500">{{ post.created_at|date('M d, Y') }}</p>
                <h3 class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors leading-snug line-clamp-2">
                  {{ post.title }}
                </h3>
                <p class="text-slate-400 text-xs leading-relaxed line-clamp-2">{{ post.excerpt }}</p>
                <div class="flex items-center gap-1.5 text-emerald-400 text-xs font-semibold pt-1">
                  Read More
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}

    {% endif %}
  </section>

  <!-- CTA Banner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="rounded-3xl bg-gradient-to-r from-emerald-950 via-slate-900 to-teal-950 border border-emerald-500/30 p-10 text-center space-y-5 shadow-[0_0_60px_rgba(5,150,105,0.15)]">
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white">Ready to automate your business?</h3>
      <p class="text-slate-400 text-sm max-w-md mx-auto">Book a free AI Strategy Call and let our architects map out your automation roadmap.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <button onclick="openModal()" class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-sm rounded-2xl shadow-lg shadow-emerald-600/30 hover:scale-105 transition">
          Book Free AI Strategy Call →
        </button>
          <a href="https://app.whatypie.in/auth/login" target="_blank" class="w-full sm:w-auto px-8 py-4 bg-slate-950 border border-emerald-500/30 hover:border-emerald-400 text-emerald-300 font-semibold text-base rounded-2xl transition flex items-center justify-center space-x-2 gap-2">
            <span>Try WhatyPie Free</span>
            <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
      </div>
    </div>
  </section>

  {% include 'components/footer.html.twig' %}
  {% include 'components/booking_modal.html.twig' %}

</div>
{% endblock %}

{% block javascripts %}
{% endblock %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SnapPHP{% endblock %}</title>
    <link rel="icon" href="{{ assets('whatypie-favicon.png') }}" type="image/png" />
    <link rel="stylesheet" href="{{ assets('css/styles.css') }}">
    <link rel="stylesheet" href="{{ assets('css/app.css') }}">
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <link rel="canonical" href="{% block canonical %}https://whatypie.in/{% endblock %}" />
    <meta name="description" content="{% block meta_description %}WhatyPie designs, builds, and manages AI-powered automation systems that streamline operations, reduce costs, and accelerate business growth.{% endblock %}" />
    {% block stylesheets %}{% endblock %}
    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-CL00EYQZL6"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-CL00EYQZL6');
</script>
</head>
<body>
    {% block header %}
    {% endblock %}

    <main>
        {% block content %}{% endblock %}
    </main>

	{% block footer %}
    {# <footer>
    	<div class="container">
        	<p>&copy; {{ "now"|date("Y") }} SnapPHP</p>
    	</div>
    </footer> #}
    {% endblock %}

    {% block javascripts %}
    <script src="{{ assets('js/app.js') }}"></script>
    {% endblock %}
</body>
</html>
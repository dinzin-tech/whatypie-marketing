  <!-- ==================== STRATEGY CALL BOOKING MODAL ==================== -->
  <div id="bookingModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="relative w-full max-w-xl bg-slate-900 border border-emerald-500/30 rounded-3xl p-6 md:p-8 text-white shadow-2xl space-y-6">
      <button onclick="closeModal()" class="absolute top-5 right-5 text-slate-400 hover:text-white font-bold text-lg">✕</button>

      <div id="modalFormContainer">
        <h3 class="text-2xl font-bold text-white">Book Your Free AI Strategy Call</h3>
        <p class="text-xs text-slate-400 mt-1">Audit your business operations with our lead AI automation architects.</p>

        <form id="bookingForm" onsubmit="handleBookingSubmit(event)" class="space-y-4 mt-6">
          <div id="bookingFormError" class="hidden px-4 py-2 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-xs"></div>

          <div>
            <label class="block text-xs text-slate-300 mb-1">Full Name *</label>
            <input required type="text" name="full_name" placeholder="John Doe" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-xs text-slate-300 mb-1">Work Email</label>
            <input type="email" name="work_email" placeholder="john@company.com" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-xs text-slate-300 mb-1">Phone Number *</label>
            <input required type="tel" name="phone_number" placeholder="+91 98765 43210" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-xs text-slate-300 mb-1">Company Name</label>
            <input type="text" name="company_name" placeholder="Acme Corp" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" />
          </div>

          <button type="submit" id="bookingSubmitBtn" class="w-full py-3 bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 text-white font-bold text-sm rounded-xl shadow-lg hover:scale-[1.01] transition">
            Confirm & Book Session
          </button>
        </form>
      </div>

      <div id="modalSuccessContainer" class="hidden text-center py-8 space-y-4">
        <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">✓</div>
        <h4 class="text-2xl font-bold text-white">Strategy Session Requested!</h4>
        <p class="text-xs text-slate-300 max-w-sm mx-auto">Our lead AI solutions architect will contact you within 2 hours to confirm your calendar booking.</p>
        <button onclick="closeModal()" class="px-6 py-2 bg-slate-800 text-white rounded-xl text-xs">Close</button>
      </div>
    </div>
  </div>

  <script>
    function toggleMobileMenu() {
      const menu = document.getElementById('mobileMenu');
      if (menu) menu.classList.toggle('hidden');
    }

    function openModal(planName) {
      const modal = document.getElementById('bookingModal');
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      const titleEl = modal.querySelector('h3');
      const descEl = modal.querySelector('p');
      const submitBtn = document.getElementById('bookingSubmitBtn');

      if (planName) {
        titleEl.textContent = `Contact Sales — ${planName}`;
        descEl.textContent = `Interested in the ${planName} plan? Submit your details to request custom scope setup and pricing details.`;
        submitBtn.textContent = `Submit Request for ${planName}`;

        let planInput = document.getElementById('modalSelectedPlan');
        if (!planInput) {
          planInput = document.createElement('input');
          planInput.type = 'hidden';
          planInput.name = 'selected_plan';
          planInput.id = 'modalSelectedPlan';
          document.getElementById('bookingForm').appendChild(planInput);
        }
        planInput.value = planName;
      } else {
        titleEl.textContent = 'Book Your Free AI Strategy Call';
        descEl.textContent = 'Audit your business operations with our lead AI automation architects.';
        submitBtn.textContent = 'Confirm & Book Session';

        const planInput = document.getElementById('modalSelectedPlan');
        if (planInput) {
          planInput.remove();
        }
      }
    }

    function closeModal() {
      const modal = document.getElementById('bookingModal');
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      
      // Reset success container and show form again for next opening
      const formContainer = document.getElementById('modalFormContainer');
      const successContainer = document.getElementById('modalSuccessContainer');
      const form = document.getElementById('bookingForm');
      if (formContainer && successContainer && form) {
        formContainer.classList.remove('hidden');
        successContainer.classList.add('hidden');
        form.reset();
        const btn = document.getElementById('bookingSubmitBtn');
        btn.disabled = false;
      }
    }

    async function handleBookingSubmit(e) {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('bookingSubmitBtn');
      const errorEl = document.getElementById('bookingFormError');

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Submitting…';
      errorEl.classList.add('hidden');

      const body = new URLSearchParams(new FormData(form));

      try {
        const res = await fetch('/booking/submit', { method: 'POST', body });
        const data = await res.json();

        if (data.success) {
          document.getElementById('modalFormContainer').classList.add('hidden');
          document.getElementById('modalSuccessContainer').classList.remove('hidden');
        } else {
          errorEl.textContent = data.message || 'Something went wrong. Please try again.';
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = originalText;
        }
      } catch {
        errorEl.textContent = 'Network error. Please try again.';
        errorEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }
  </script>

<!-- ==================== TRUSTED BY SECTION ==================== -->
<section id="trusted-by" class="py-24 bg-slate-950/80 border-y border-slate-900/60 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h3 class="text-center text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-14">
      Trusted By Businesses Across Industries
    </h3>

    <!-- Logo Ticker Container -->
    <div class="relative w-full overflow-hidden whitespace-nowrap [mask-image:_linear-gradient(to_right,transparent_0,_black_10%,_black_90%,transparent_100%)]">
      {% set brands = [
        {
          'name': 'Trilok Constructions',
          'url': 'https://trilokconstructions.com',
          'image': 'trilok-logo.jpg',
          'width': 140,
          'height': 40,
          'image_class': 'max-h-12 max-w-[170px] object-contain'
        },
        {
          'name': 'Abhaya Vastra',
          'url': 'https://abhayavastra.store',
          'image': 'abhaya-logo.png',
          'width': 120,
          'height': 48,
          'image_class': 'max-h-14 max-w-[180px] object-contain'
        },
        {
          'name': 'Vishvam Foundation',
          'url': 'https://vishvamfoundation.org',
          'image': 'vishvam-logo.png',
          'width': 150,
          'height': 36,
          'image_class': 'max-h-11 max-w-[190px] object-contain'
        },
        {
          'name': 'SkyLead Aviation',
          'url': 'https://skyleadaviation.com',
          'image': 'skybound-logo.png',
          'width': 150,
          'height': 36,
          'image_class': 'max-h-[200px] max-w-[190px] object-contain'
        },
        {
          'name': 'Yadav Tours',
          'url': 'https://yadavtours.in',
          'image': 'yadav-logo.png',
          'width': 120,
          'height': 48,
          'image_class': 'max-h-14 max-w-[180px] object-contain'
        },
        {
          'name': 'Skybound Studio',
          'url': 'https://skyboundstudio.in',
          'type': 'text',
          'text': 'SKYBOUND',
          'text_class': 'gap-1.5 text-white font-extrabold tracking-wider text-sm'
        },
        {
          'name': 'Dinzin Technologies',
          'url': 'https://dinzin.in',
          'image': 'dinzin-logo.png',
          'width': 150,
          'height': 36,
          'image_class': 'max-h-11 max-w-[190px] object-contain'
        }
      ] %}

      <div class="inline-flex gap-20 items-center animate-marquee">
        {% for i in 0..1 %}
          {% for brand in brands %}
            <a href="{{ brand.url }}" target="_blank" class="h-14 flex items-center justify-center grayscale opacity-45 hover:grayscale-0 hover:opacity-100 transition-all duration-300{% if brand.type == 'text' %} {{ brand.text_class }}{% endif %}">
              {% if brand.type == 'text' %}
                <span>🎬</span> {{ brand.text }}
              {% else %}
                <img src="{{ assets(brand.image) }}" alt="{{ brand.name }}" width="{{ brand.width }}" height="{{ brand.height }}" loading="lazy" class="{{ brand.image_class }}" />
              {% endif %}
            </a>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    display: inline-flex;
    animation: marquee 30s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>

{% extends 'base.html.twig' %}

{% block title %}About WhatyPie & Dinzin Technology | WhatyPie{% endblock %}

{% block canonical %}https://whatypie.in/about{% endblock %}

{% block meta_description %}Learn about WhatyPie, our parent entity Dinzin Technology, and our mission to orchestrate high-accuracy AI automation workflows.{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } } }
  </script>
  <style>
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #020617; }
    ::-webkit-scrollbar-thumb { background: #059669; border-radius: 4px; }
  </style>
{% endblock %}

{% block content %}
<div class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

  {% include 'components/header.html.twig' %}

  <!-- Page Header -->
  <section class="relative pt-36 pb-12 overflow-hidden text-center">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-emerald-600/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 text-xs font-semibold uppercase tracking-widest">
        <span>Our Mission & Team</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">About WhatyPie</h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto">
        WhatyPie is a leading enterprise AI Automation & Business Transformation Agency dedicated to building intelligent workflows for modern companies.
      </p>
    </div>
  </section>

  <!-- Detailed About Content -->
  <section class="py-12 bg-slate-950 relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="space-y-6 text-slate-300 leading-relaxed text-sm sm:text-base">
        <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-2">We Don't Just Sell Software. We Build Systems.</h2>
        <p>
          At WhatyPie, we believe that software alone is useless without customized operational business logic. Most companies deploy isolated chat bots that create fragmented operational chaos. We take a different approach—we design custom, cohesive AI architectures that align with your exact business rules, company culture, and tools.
        </p>
        <p>
          From initial ad clicks to CRM updates, calendar invitations, billing events, and volunteer communications, we connect your entire workflow in a unified cognitive pipeline.
        </p>
      </div>

      <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 space-y-6">
        <h2 class="text-lg font-bold text-white">Our Parent Entity</h2>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <img src="{{ assets('dinzin-logo.png') }}" alt="Dinzin Logo" class="h-10 object-contain bg-slate-950/60 p-2 rounded-xl border border-slate-800" />
          <div class="space-y-1.5">
            <h3 class="text-white font-bold text-sm">Dinzin Technology Solutions Private Limited</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              WhatyPie is built, operated, and maintained by <strong>Dinzin Technology Solutions Private Limited</strong>. Dinzin is a premier IT consulting and product company driving digital transformation and intelligent engineering services globally.
            </p>
            <a href="https://www.dinzin.in" target="_blank" class="text-xs text-emerald-400 hover:text-emerald-300 font-medium hover:underline">
              Learn more at www.dinzin.in
            </a>
          </div>
        </div>
      </div>

      <div class="space-y-6 text-slate-300 leading-relaxed text-sm sm:text-base">
        <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-2">Our Operating Philosophy</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <h3 class="text-emerald-400 font-bold text-sm">Empower Teams</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              We build AI solutions to handle repetitive 80% baseline tasks so your team can focus on high-value strategy, relationships, and deal closing.
            </p>
          </div>
          <div class="space-y-2">
            <h3 class="text-emerald-400 font-bold text-sm">Ongoing Optimization</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              AI requires ongoing memory updates and prompt refinement. We act as your dedicated AI engineering partners for continuous accuracy and scale.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA section -->
  <section class="py-20 bg-slate-950 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="p-10 sm:p-16 rounded-3xl bg-slate-900/90 border border-emerald-500/30 backdrop-blur-2xl text-center space-y-8 shadow-[0_0_80px_rgba(5,150,105,0.2)]">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Let's Partner Together
        </h2>
        <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto">
          Audit your operational workflows with our lead engineers and build an automated system that drives measurable growth.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <button onclick="openModal()" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 text-white font-bold text-base rounded-2xl shadow-xl shadow-emerald-600/30 hover:scale-105 transition">
            Book Free AI Strategy Call →
          </button>
          <a href="https://wa.me/917411001943" target="_blank" class="w-full sm:w-auto px-8 py-4 bg-slate-950 border border-emerald-500/30 hover:border-emerald-400 text-emerald-300 font-semibold text-base rounded-2xl transition flex items-center justify-center space-x-2 gap-2">
            <svg class="w-5 h-5 fill-emerald-400" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.457L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.42 9.863-9.864.001-2.637-1.03-5.114-2.905-6.989-1.874-1.873-4.36-2.903-6.999-2.904-5.442 0-9.87 4.421-9.872 9.867-.001 1.8.49 3.55 1.42 5.09L1.9 22.095l6.747-1.768zm10.63-7.876c-.226-.113-1.34-.662-1.549-.739-.208-.076-.36-.113-.51.113-.15.225-.58.739-.711.89-.13.15-.26.168-.486.055-.226-.113-.956-.352-1.821-1.124-.672-.6-1.127-1.341-1.259-1.566-.131-.225-.014-.347.099-.459.102-.101.226-.263.338-.395.113-.131.15-.225.226-.375.075-.15.038-.281-.019-.394-.056-.113-.51-1.228-.699-1.687-.184-.443-.371-.383-.51-.39-.134-.007-.288-.009-.442-.009-.155 0-.407.058-.621.288-.213.23-.814.796-.814 1.942 0 1.146.833 2.251.948 2.401.115.15 1.636 2.5 3.964 3.506.553.24 1.055.399 1.416.514.557.177 1.063.152 1.464.092.446-.067 1.34-.548 1.529-1.077.19-.529.19-.983.133-1.077-.058-.094-.208-.15-.434-.263z"/></svg>
            <span>Talk to an Automation Expert</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {% include 'components/footer.html.twig' %}
  {% include 'components/booking_modal.html.twig' %}

</div>
{% endblock %}

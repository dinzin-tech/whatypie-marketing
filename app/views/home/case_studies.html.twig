{% extends 'base.html.twig' %}

{% block title %}Automation Case Studies | WhatyPie{% endblock %}

{% block canonical %}https://whatypie.in/case-studies{% endblock %}

{% block meta_description %}Read how WhatyPie helped Trilok Constructions, Abhaya Vastra, and Vishvam Foundation streamline workflows and grow with AI automation.{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } } }
  </script>
  <style>
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #020617; }
    ::-webkit-scrollbar-thumb { background: #059669; border-radius: 4px; }
  </style>
{% endblock %}

{% block content %}
<div class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

  {% include 'components/header.html.twig' %}

  <!-- Page Header -->
  <section class="relative pt-36 pb-12 overflow-hidden text-center">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-emerald-600/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 text-xs font-semibold uppercase tracking-widest">
        <span>Proven Business Impact</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">Case Studies & Success Stories</h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto">
        Read the actual metrics, workflows, and solutions we built to solve real-world operational challenges.
      </p>
    </div>
  </section>

  <!-- Case Studies Section -->
  <section class="py-12 bg-slate-950 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Case Study 1: Trilok Constructions -->
      <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 border border-slate-800/80 space-y-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="space-y-1.5">
            <span class="inline-block text-[10px] uppercase font-semibold tracking-wider px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400">Real Estate & Construction</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Trilok Constructions</h2>
          </div>
          <div class="flex items-center gap-2 text-right">
            <span class="text-xs text-slate-400">Impact:</span>
            <span class="text-lg font-bold text-emerald-400">~95% Booking Accuracy</span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 border-t border-slate-800/80 pt-8">
          <div>
            <h3 class="text-emerald-400 font-bold text-sm mb-2">The Challenge</h3>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
              Trilok Constructions faced long delays responding to incoming lead inquiries from online ad campaigns, resulting in dropped lead conversion rates and empty property viewing calendar slots.
            </p>
          </div>
          <div>
            <h3 class="text-emerald-400 font-bold text-sm mb-2">Our Solution</h3>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
              We deployed an official WhatsApp Business API integration backed by our custom AI qualification agent. The bot answers customer inquiries, qualifies their intent level, shares digital property brochures, and schedules site viewings automatically.
            </p>
          </div>
          <div>
            <h3 class="text-emerald-400 font-bold text-sm mb-2">The Metrics</h3>
            <ul class="space-y-2 text-xs sm:text-sm text-slate-400">
              <li><strong class="text-white">0.2 seconds</strong> Average lead response time</li>
              <li><strong class="text-white">1,200+ leads</strong> Qualified autonomously</li>
              <li><strong class="text-white">350+ visits</strong> Scheduled into Google Calendar</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Case Study 2: Abhaya Vastra -->
      <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 border border-slate-800/80 space-y-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="space-y-1.5">
            <span class="inline-block text-[10px] uppercase font-semibold tracking-wider px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400">Fashion Retail</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Abhaya Vastra</h2>
          </div>
          <div class="flex items-center gap-2 text-right">
            <span class="text-xs text-slate-400">Impact:</span>
            <span class="text-lg font-bold text-emerald-400">+24% Cart Recovery</span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 border-t border-slate-800/80 pt-8">
          <div>
            <h3 class="text-emerald-400 font-bold text-sm mb-2">The Challenge</h3>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
              Abhaya Vastra's e-commerce shop experienced high shopping cart abandonment rates, and their human sales team spent hours manually emailing customers to recover sales.
            </p>
          </div>
          <div>
            <h3 class="text-emerald-400 font-bold text-sm mb-2">Our Solution</h3>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
              We connected their store with an automated checkout database sync that detects unfinished checkouts and triggers personalized WhatsApp and email recovery sequences using dynamic discount links.
            </p>
          </div>
          <div>
            <h3 class="text-emerald-400 font-bold text-sm mb-2">The Metrics</h3>
            <ul class="space-y-2 text-xs sm:text-sm text-slate-400">
              <li><strong class="text-white">24% increase</strong> in recovered checkouts</li>
              <li><strong class="text-white">4.8/5.0 score</strong> Customer service review score</li>
              <li><strong class="text-white">100% automated</strong> No manual staff follow-up required</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA section -->
  <section class="py-20 bg-slate-950 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="p-10 sm:p-16 rounded-3xl bg-slate-900/90 border border-emerald-500/30 backdrop-blur-2xl text-center space-y-8 shadow-[0_0_80px_rgba(5,150,105,0.2)]">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Let's Build Your Success Story
        </h2>
        <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto">
          Audit your operational workflows with our lead engineers and build an automated system that drives measurable growth.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <button onclick="openModal()" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 text-white font-bold text-base rounded-2xl shadow-xl shadow-emerald-600/30 hover:scale-105 transition">
            Book Free AI Strategy Call →
          </button>
          <a href="https://wa.me/917411001943" target="_blank" class="w-full sm:w-auto px-8 py-4 bg-slate-950 border border-emerald-500/30 hover:border-emerald-400 text-emerald-300 font-semibold text-base rounded-2xl transition flex items-center justify-center space-x-2 gap-2">
            <svg class="w-5 h-5 fill-emerald-400" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.457L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.42 9.863-9.864.001-2.637-1.03-5.114-2.905-6.989-1.874-1.873-4.36-2.903-6.999-2.904-5.442 0-9.87 4.421-9.872 9.867-.001 1.8.49 3.55 1.42 5.09L1.9 22.095l6.747-1.768zm10.63-7.876c-.226-.113-1.34-.662-1.549-.739-.208-.076-.36-.113-.51.113-.15.225-.58.739-.711.89-.13.15-.26.168-.486.055-.226-.113-.956-.352-1.821-1.124-.672-.6-1.127-1.341-1.259-1.566-.131-.225-.014-.347.099-.459.102-.101.226-.263.338-.395.113-.131.15-.225.226-.375.075-.15.038-.281-.019-.394-.056-.113-.51-1.228-.699-1.687-.184-.443-.371-.383-.51-.39-.134-.007-.288-.009-.442-.009-.155 0-.407.058-.621.288-.213.23-.814.796-.814 1.942 0 1.146.833 2.251.948 2.401.115.15 1.636 2.5 3.964 3.506.553.24 1.055.399 1.416.514.557.177 1.063.152 1.464.092.446-.067 1.34-.548 1.529-1.077.19-.529.19-.983.133-1.077-.058-.094-.208-.15-.434-.263z"/></svg>
            <span>Talk to an Automation Expert</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {% include 'components/footer.html.twig' %}
  {% include 'components/booking_modal.html.twig' %}

</div>
{% endblock %}

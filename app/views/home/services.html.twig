{% extends 'base.html.twig' %}

{% block title %}AI & Business Automation Services | WhatyPie{% endblock %}

{% block canonical %}https://whatypie.in/services{% endblock %}

{% block meta_description %}Discover our AI automation services: autonomous agents, business workflow optimization, WhatsApp integrations, and CRM sync blueprints.{% endblock %}

{% block stylesheets %}
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } } }
  </script>
  <style>
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #020617; }
    ::-webkit-scrollbar-thumb { background: #059669; border-radius: 4px; }
  </style>
{% endblock %}

{% block content %}
<div class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

  {% include 'components/header.html.twig' %}

  <!-- Page Header -->
  <section class="relative pt-36 pb-12 overflow-hidden text-center">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-emerald-600/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
      <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 text-xs font-semibold uppercase tracking-widest">
        <span>Full-Stack AI Transformation</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">Our Services</h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto">
        We design, build, and manage AI-powered automation systems that eliminate manual overhead, improve productivity, and help businesses scale faster.
      </p>
    </div>
  </section>

  <!-- Detailed Services Section -->
  <section class="py-12 bg-slate-950 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Service 1: AI Automation -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center border-b border-slate-900 pb-16">
        <div class="space-y-6">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-700 flex items-center justify-center text-white font-bold text-xl shadow-lg">
            🤖
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">AI Automation & Autonomous Agents</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Deploy intelligent AI agents capable of handling complex decision-making, natural language inquiries, and multi-step tasks across your business. By integrating LLMs and cognitive pipelines, our agents act as dedicated virtual assistants working 24/7.
          </p>
          <ul class="space-y-2 text-sm text-slate-400">
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Auto-qualification of client intent</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Multi-agent cognitive decision pipelines</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Custom agent memory and context databases</li>
          </ul>
        </div>
        <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
          <h3 class="text-emerald-400 font-bold text-sm">Example Scenario</h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            An incoming customer inquiry triggers an AI agent that automatically reads the query, matches it against internal product documentation, retrieves pricing data, drafts a reply, and notifies the account manager—all in under 2 seconds.
          </p>
        </div>
      </div>

      <!-- Service 2: Business Automation -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center border-b border-slate-900 pb-16 lg:grid-flow-col-dense">
        <div class="space-y-6 lg:col-start-2">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-700 flex items-center justify-center text-white font-bold text-xl shadow-lg">
            ⚡
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Business Process & Workflow Automation</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Streamline day-to-day business operations by eliminating manual handoffs, repetitive data entry, and fragmented operational bottlenecks. We map out and automate your entire operational flow, connecting disparate SaaS tools seamlessly.
          </p>
          <ul class="space-y-2 text-sm text-slate-400">
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> End-to-end operational workflow design</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Legacy system integration and API linking</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Real-time dashboard and tracking systems</li>
          </ul>
        </div>
        <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 space-y-4 lg:col-start-1">
          <h3 class="text-emerald-400 font-bold text-sm">Example Scenario</h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            We sync your invoicing systems directly with CRM pipelines so that closing a deal automatically drafts the invoice, emails the customer, registers the payment, and triggers service provisioning without human intervention.
          </p>
        </div>
      </div>

      <!-- Service 3: WhatsApp Automation -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center border-b border-slate-900 pb-16">
        <div class="space-y-6">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-700 flex items-center justify-center text-white font-bold text-xl shadow-lg">
            💬
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Enterprise WhatsApp Business Automation</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Harness the official WhatsApp Business API powered by AI agents to support instant customer support, catalog browsing, lead qualification, and instant appointment booking.
          </p>
          <ul class="space-y-2 text-sm text-slate-400">
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Official WhatsApp Cloud API integration</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Live-agent routing and fallback systems</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Automated calendar booking and CRM synchronization</li>
          </ul>
        </div>
        <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
          <h3 class="text-emerald-400 font-bold text-sm">Example Scenario</h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            A prospect scans a QR code, qualifying their budget and timeline automatically with the WhatsApp AI assistant, which then presents available calendar openings, schedules the site visit, and pushes the event to Google Calendar.
          </p>
        </div>
      </div>

      <!-- Service 4: CRM Solutions -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-6 lg:col-start-2">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-700 flex items-center justify-center text-white font-bold text-xl shadow-lg">
            📊
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Custom CRM & Database Solutions</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Implement and customize centralized CRM architectures that track customer journeys, predict intent, and automate sales follow-ups. We sync all customer touchpoints into a unified intelligence panel.
          </p>
          <ul class="space-y-2 text-sm text-slate-400">
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Lead routing, scoring, and follow-up alerts</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Custom field matching and dashboard reports</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> Database security, replication, and data warehousing</li>
          </ul>
        </div>
        <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 space-y-4 lg:col-start-1">
          <h3 class="text-emerald-400 font-bold text-sm">Example Scenario</h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            A lead score changes in the CRM as they download multiple brochures, triggering a high-priority task for sales agents and drafting an automated email sequence tailored to that user's specific product interests.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA section -->
  <section class="py-20 bg-slate-950 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="p-10 sm:p-16 rounded-3xl bg-slate-900/90 border border-emerald-500/30 backdrop-blur-2xl text-center space-y-8 shadow-[0_0_80px_rgba(5,150,105,0.2)]">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Ready to Automate Your Services?
        </h2>
        <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto">
          Let's map out your services and identify the highest impact automation bottlenecks today.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <button onclick="openModal()" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 text-white font-bold text-base rounded-2xl shadow-xl shadow-emerald-600/30 hover:scale-105 transition">
            Book Free AI Strategy Call →
          </button>
          <a href="https://app.whatypie.in/auth/login" target="_blank" class="w-full sm:w-auto px-8 py-4 bg-slate-950 border border-emerald-500/30 hover:border-emerald-400 text-emerald-300 font-semibold text-base rounded-2xl transition flex items-center justify-center space-x-2 gap-2">
            <span>Try WhatyPie Free</span>
            <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {% include 'components/footer.html.twig' %}
  {% include 'components/booking_modal.html.twig' %}

</div>
{% endblock %}
